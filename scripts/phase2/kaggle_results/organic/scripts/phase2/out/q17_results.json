{
  "question": "Does eating organic food improve your health?",
  "provenance": {
    "dataset": "Lock5Data: OrganicEffect (160 obs, 6 vars) - real Lock5 dataset",
    "data_source": "Downloaded verbatim from https://www.lock5stat.com/datasets3e/OrganicEffect.csv to data/phase2/q17_organic.csv (Lock5 3e/4e data pages checked Oct 2026; no dataset named 'OrganicFood' exists).",
    "citation": "Magner J, Wallberg P, Sandberg J, Cousins AP (2015). Human exposure to pesticides from food: A pilot study (Report U 5080). IVL Swedish Environmental Research Institute, for Coop Sverige AB, January 2015.",
    "report_url": "https://www.coop.se/PageFiles/429812/Coop%20Ekoeffekten_Report%20ENG.pdf",
    "design": "Within-family before/after pilot: Swedish family of five (2 adults, 3 children) ate a conventional diet, then only organic food for two weeks; 8 pesticides measured in morning urine (micrograms/g creatinine) on 4 days per diet -> 5 x 8 x 4 = 160 paired observations",
    "endpoint_note": "Endpoint is urinary pesticide concentration - a health-relevant exposure biomarker, not a clinical health outcome. Smith-Spangler et al. 2012 (Ann Intern Med 157:348-366) and the Norwegian MoBa cohort (Torjusen et al. 2012, BMC Public Health 12:612) have no Lock5 dataset.",
    "caution": "Single family (n=5); diet order not randomized; repeated days within person x pesticide are not fully independent; reduced exposure does not by itself establish a health benefit (measured levels were below the ADI)."
  },
  "published_headlines": {
    "ivl_report": {
      "statement": "Urinary pesticide-residue concentrations decreased on average by a factor of 6.7 on the organic diet",
      "extra": "Children in particular had lower concentrations; levels of most, but not all, pesticides fell in adults; measured levels estimated below the ADI by a good margin."
    }
  },
